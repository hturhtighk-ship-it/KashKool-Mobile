{
  "name": "kashkool-desktop",
  "version": "74.0.0",
  "private": true,
  "description": "KashKool study planner with Windows tray background support, signature themes with their own motion, identity colour and page transition, and resilient cloud sync.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/check-project.cjs",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.kashkool.study",
    "productName": "KashKool",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets/icons"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "desktop/**/*",
      "kashkool-sw.js",
      "kashkool.webmanifest",
      "package.json"
    ],
    "win": {
      "icon": "assets/icons/kashkool.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KashKool",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
